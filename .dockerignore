# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore
.github

# Model binaries under models/ are NOT ignored: the Dockerfile bakes
# models/<language>/ into the image.

# ── Secrets / local config ───────────────────────────────────────────────────
.env
*.env
secrets/

# ── Python artefacts ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# ── Test / CI ────────────────────────────────────────────────────────────────
tests/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# ── Docs / extra files ───────────────────────────────────────────────────────
README.md
*.rst
docs/

# ── Dev tooling ──────────────────────────────────────────────────────────────
.editorconfig
.pre-commit-config.yaml
Makefile

# ── Sibling deploy configs (not needed inside image) ────────────────────────
deploy/

# ── Audio test files ─────────────────────────────────────────────────────────
*.wav
*.mp3
*.flac
*.ogg
